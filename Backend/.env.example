TYPEDB_HOST=localhost
TYPEDB_PORT=1729
TYPEDB_DATABASE=orgsim
# TypeDB 3.x Core (defaults match a fresh local server; override if you created users)
TYPEDB_USER=admin
TYPEDB_PASSWORD=password
# Set to 1 to drop and recreate the TypeDB database before init (first load / schema edits).
TYPEDB_INIT_DROP=0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orgsimpass
NATS_URL=nats://localhost:4222
TEMPORAL_HOST=localhost:7233
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Wire POST /simulate → Simulation service (8001) → NATS for the live WebSocket feed.
SIMULATION_SERVICE_URL=http://127.0.0.1:8001
